{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-image-studio",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",

  "observability": { "enabled": true },

  "ai": { "binding": "AI" },

  "kv_namespaces": [
    { "binding": "CACHE", "id": "cf4b3307b967415ab2f40815f5394c19" }
  ],

  "durable_objects": {
    "bindings": [{ "name": "QUOTA", "class_name": "Quota" }]
  },
  "exports": {
    "Quota": { "type": "durable-object", "storage": "sqlite" }
  }
}
